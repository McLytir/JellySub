<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core — required for [ApiController], IActionResult, [Authorize] etc.
         frameworkReferences are NOT transitively propagated by NuGet, so we must
         declare this explicitly even though Jellyfin.Common carries it internally. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin APIs — referenced but NOT shipped (already present in the host process).
         Pinned to 10.10.7 (latest stable 10.10 release, matching targetAbi in build.yaml).
         Bump when upgrading the target Jellyfin version. -->
    <PackageReference Include="Jellyfin.Common"     Version="10.10.7" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Controller" Version="10.10.7" PrivateAssets="All" />
    <PackageReference Include="Jellyfin.Data"       Version="10.10.7" PrivateAssets="All" />

    <!-- HTML scraping -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.62" />

    <!-- HTTP client factory support -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <!-- Embed all web pages as resources (forward-slash glob — works on all OSes) -->
  <ItemGroup>
    <EmbeddedResource Include="Web/*.html" />
    <EmbeddedResource Include="Web/*.js"   />
    <EmbeddedResource Include="WebClient/*.js" />
    <None            Remove="Web/*.html"   />
    <None            Remove="Web/*.js"     />
    <None            Remove="WebClient/*.js" />
  </ItemGroup>

</Project>
